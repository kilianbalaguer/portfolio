# Public site URL (used for SEO metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.kilianbalaguer.tech

# Umami analytics — optional overrides (defaults live in components/analytics.tsx)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: self-hosted Umami script (defaults to Umami Cloud)
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# Optional: only track on these domains (comma-separated), so localhost isn't counted
# NEXT_PUBLIC_UMAMI_DOMAINS=kilianbalaguer.tech,www.kilianbalaguer.tech
